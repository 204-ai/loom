            "wgsl_decode": {
              "definitionVersion": 1,
              "format": {
                "mode": "project"
              },
              "id": "wgsl_decode",
              "label": "wgsl_decode",
              "parameters": {
                "amount": 1,
                "source": "// Loom works in linear light and straight alpha (SPEC V56). TouchDesigner's TOPs hold\n// sRGB-encoded 8-bit values, and every operator in drmbt's network does its maths on those\n// numbers. wgsl_encode and wgsl_decode bracket the TD chain so a threshold of 0.05, a\n// brightness of 1.64, a soft light and an emboss all mean exactly what they meant in TD.\n// This half: sRGB-encoded values -> linear, back into the project's working space.\nstruct Params {\n  amount: f32,\n};\n\n@group(0) @binding(0) var inputSampler: sampler;\n@group(0) @binding(1) var inputTexture: texture_2d<f32>;\n@group(0) @binding(3) var<uniform> params: Params;\n\nfn decodeSrgb(encoded: vec3f) -> vec3f {\n  let c = clamp(encoded, vec3f(0.0), vec3f(1.0));\n  let high = pow((c + vec3f(0.055)) / 1.055, vec3f(2.4));\n  return select(high, c / 12.92, c <= vec3f(0.04045));\n}\n\n@fragment\nfn fs(@location(0) uv: vec2f) -> @location(0) vec4f {\n  let source = textureSampleLevel(inputTexture, inputSampler, uv, 0.0);\n  // Amount must match wgsl_encode's: 1 decodes, 0 passes the values through.\n  return vec4f(mix(source.rgb, decodeSrgb(source.rgb), params.amount), source.a);\n}"
              },
              "position": {
                "x": 3612,
                "y": -74
              },
              "type": "customWgsl"
            },
            "wgsl_encode": {
              "definitionVersion": 1,
              "format": {
                "format": "rgba8unorm",
                "mode": "fixed"
              },
              "id": "wgsl_encode",
              "label": "wgsl_encode",
              "parameters": {
                "amount": 1,
                "source": "// Loom works in linear light and straight alpha (SPEC V56). TouchDesigner's TOPs hold\n// sRGB-encoded 8-bit values, and every operator in drmbt's network does its maths on those\n// numbers. wgsl_encode and wgsl_decode bracket the TD chain so a threshold of 0.05, a\n// brightness of 1.64, a soft light and an emboss all mean exactly what they meant in TD.\n// This half: linear -> sRGB-encoded values (the exact piecewise sRGB curve).\nstruct Params {\n  amount: f32,\n};\n\n@group(0) @binding(0) var inputSampler: sampler;\n@group(0) @binding(1) var inputTexture: texture_2d<f32>;\n@group(0) @binding(3) var<uniform> params: Params;\n\nfn encodeSrgb(linear: vec3f) -> vec3f {\n  let c = clamp(linear, vec3f(0.0), vec3f(1.0));\n  let high = (1.055 * pow(c, vec3f(1.0 / 2.4))) - vec3f(0.055);\n  return select(high, c * 12.92, c <= vec3f(0.0031308));\n}\n\n@fragment\nfn fs(@location(0) uv: vec2f) -> @location(0) vec4f {\n  let source = textureSampleLevel(inputTexture, inputSampler, uv, 0.0);\n  let plain = clamp(source.rgb, vec3f(0.0), vec3f(1.0));\n  // Amount 1 encodes. 0 leaves linear values in place, to A/B the TD maths against Loom's.\n  return vec4f(mix(plain, encodeSrgb(source.rgb), params.amount), source.a);\n}"
              },
              "position": {
                "x": 258,
                "y": -184
              },
              "type": "customWgsl"
            },
            "wgsl_maximum": {
              "definitionVersion": 1,
              "format": {
                "format": "rgba8unorm",
                "mode": "fixed"
              },
              "id": "wgsl_maximum",
              "label": "wgsl_maximum",
              "parameters": {
                "amount": 1,
                "source": "// TD Composite TOP, operation Maximum (comp2 in drmbt's watercolor): per channel\n// max(a, b), alpha included, as TD returns it. a is input 0 (the grained input), b is\n// input 1 (the bled feedback, wired into More). This node is also what the feedback\n// records, so the trail can only ever brighten the picture under it.\nstruct Params {\n  amount: f32,\n};\n\n@group(0) @binding(0) var inputSampler: sampler;\n@group(0) @binding(1) var inputTexture: texture_2d<f32>;\n@group(0) @binding(3) var<uniform> params: Params;\n@group(0) @binding(4) var inputTexture1: texture_2d<f32>;\n\nfn secondAt(uv: vec2f) -> vec4f {\n  let size = vec2i(textureDimensions(inputTexture1));\n  let texel = clamp(vec2i(uv * vec2f(size)), vec2i(0), size - vec2i(1));\n  return textureLoad(inputTexture1, texel, 0);\n}\n\n@fragment\nfn fs(@location(0) uv: vec2f) -> @location(0) vec4f {\n  let a = textureSampleLevel(inputTexture, inputSampler, uv, 0.0);\n  let b = secondAt(uv);\n  // Amount mixes from input 0 alone (0) to the full maximum (1).\n  return mix(a, max(a, b), params.amount);\n}"
              },
              "position": {
                "x": 2064,
                "y": -90
              },
              "type": "customWgslMulti"
            },
            "wgsl_softlight": {
              "definitionVersion": 1,
              "format": {
                "format": "rgba8unorm",
                "mode": "fixed"
              },
              "id": "wgsl_softlight",
              "label": "wgsl_softlight",
              "parameters": {
                "amount": 1,
                "source": "// TD Composite TOP, operation Soft Light (comp3 in drmbt's watercolor).\n// Measured in TD 2025.33230 on two ramps: per channel (1 - 2b) * a^2 + 2b * a, the Pegtop\n// form rather than the W3C one, where a is input 0 (the base: the drifted feedback) and\n// b is input 1 (the blend: the grained input, wired into More). Alpha is input 0's.\nstruct Params {\n  amount: f32,\n};\n\n@group(0) @binding(0) var inputSampler: sampler;\n@group(0) @binding(1) var inputTexture: texture_2d<f32>;\n@group(0) @binding(3) var<uniform> params: Params;\n@group(0) @binding(4) var inputTexture1: texture_2d<f32>;\n\nfn secondAt(uv: vec2f) -> vec4f {\n  let size = vec2i(textureDimensions(inputTexture1));\n  let texel = clamp(vec2i(uv * vec2f(size)), vec2i(0), size - vec2i(1));\n  return textureLoad(inputTexture1, texel, 0);\n}\n\n@fragment\nfn fs(@location(0) uv: vec2f) -> @location(0) vec4f {\n  let a = textureSampleLevel(inputTexture, inputSampler, uv, 0.0);\n  let b = secondAt(uv);\n  let soft = ((vec3f(1.0) - (2.0 * b.rgb)) * a.rgb * a.rgb) + (2.0 * b.rgb * a.rgb);\n  // Amount mixes from the base (0) to the full soft light (1).\n  return vec4f(mix(a.rgb, soft, params.amount), a.a);\n}"
              },
              "position": {
                "x": 1032,
                "y": -184
              },
              "type": "customWgslMulti"
            }
          },
          "revision": 1
        },
